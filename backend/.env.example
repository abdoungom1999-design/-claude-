# Serveur
PORT=3000
# URL publiquement accessible de cette API (utilisée pour construire
# l'URL de notification transmise à Orange Money).
APP_PUBLIC_URL="http://localhost:3000"

# PostgreSQL (extension PostGIS activée via la migration initiale)
DATABASE_URL="postgresql://sprint:sprint@localhost:5432/sprint?schema=public"

# Redis (positions GPS temps réel, cache, files d'attente)
REDIS_URL="redis://localhost:6379"

# JWT - générer des secrets forts distincts en production (ex: openssl rand -hex 64)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20

# Paiement mobile (Wave / Orange Money) - intégration réelle.
# Aucune clé fournie ici : à obtenir auprès de chaque prestataire pour
# activer les paiements. Tant que les clés sont vides, les endpoints
# d'initiation répondent 503 "non configuré" au lieu de planter.

# Wave (https://www.wave.com) - clé API Checkout.
WAVE_API_URL="https://api.wave.com/v1"
WAVE_API_KEY=
# Secret de signature des webhooks (en-tête "Wave-Signature", format
# Stripe "t=...,v1=..."), fourni par le tableau de bord Wave.
WAVE_WEBHOOK_SECRET=
# URLs de redirection après paiement (deep link app ou page web).
WAVE_SUCCESS_URL="sprint://paiement/succes"
WAVE_ERROR_URL="sprint://paiement/echec"

# Orange Money - authentification OAuth2 (client_credentials) puis appel
# du service de paiement web avec une clé marchande dédiée.
ORANGE_MONEY_AUTH_URL="https://api.orange.com/oauth/v3/token"
ORANGE_MONEY_API_URL="https://api.orange.com/orange-money-webpay/sn/v1"
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
# Secret de signature des webhooks (en-tête "X-OM-Signature").
ORANGE_MONEY_WEBHOOK_SECRET=
ORANGE_MONEY_RETURN_URL="sprint://paiement/succes"
ORANGE_MONEY_CANCEL_URL="sprint://paiement/echec"

# Tarification (FCFA) - montants indicatifs, à ajuster selon le marché.
# Vitesse moyenne utilisée pour estimer la durée en l'absence de moteur
# d'itinéraire réel.
PRICING_VITESSE_MOYENNE_KMH=22
PRICING_PASSAGER_PRISE_EN_CHARGE=500
PRICING_PASSAGER_PAR_KM=150
PRICING_PASSAGER_PAR_MINUTE=50
PRICING_PASSAGER_PRIX_MINIMUM=500
PRICING_COLIS_PRISE_EN_CHARGE=700
PRICING_COLIS_PAR_KM=200
PRICING_COLIS_PAR_MINUTE=40
PRICING_COLIS_PRIX_MINIMUM=700
