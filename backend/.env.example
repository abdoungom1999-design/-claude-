# Serveur
PORT=3000

# PostgreSQL (extension PostGIS activée via la migration initiale)
DATABASE_URL="postgresql://sprint:sprint@localhost:5432/sprint?schema=public"

# Redis (positions GPS temps réel, cache, files d'attente)
REDIS_URL="redis://localhost:6379"

# JWT - générer des secrets forts distincts en production (ex: openssl rand -hex 64)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20

# Paiement mobile (Wave / Orange Money) - à renseigner lors de l'intégration
WAVE_API_KEY=
WAVE_API_URL=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_URL=
