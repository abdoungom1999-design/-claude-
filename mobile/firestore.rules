rules_version = '2';

// Règles Firestore du projet Sprint VTC. À publier dans Console Firebase >
// Firestore Database > Règles (voir FIREBASE_SETUP.md, étape 6).
// Testées sur l'émulateur Firestore : voir firestore_rules_test/.
//
// Principe : tout est refusé par défaut. Chaque collection n'ouvre que
// les accès dont l'app a réellement besoin.
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }

    function moi() {
      return request.auth.uid;
    }

    function profil() {
      return get(/databases/$(database)/documents/users/$(moi())).data;
    }

    // Le rôle admin se pose uniquement depuis la Console Firebase : aucune
    // règle ne permet à un utilisateur de s'attribuer ce rôle.
    function estAdmin() {
      return connecte()
        && exists(/databases/$(database)/documents/users/$(moi()))
        && profil().role == 'admin';
    }

    // Chauffeur autorisé à voir et prendre des courses : dossier KYC validé
    // par l'Admin et compte ni suspendu ni banni.
    function conducteurActif() {
      let p = profil();
      return connecte()
        && p.role == 'conducteur'
        && p.get('statutValidation', null) == 'valide'
        && !(p.get('statutCompte', 'actif') in ['suspendu', 'banni']);
    }

    function champsModifies() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------------------------------------------------------------
    // Profil privé : identité, pièces KYC, statuts de validation et de
    // modération. Lisible uniquement par son propriétaire et l'Admin.
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if connecte() && (moi() == uid || estAdmin());

      // Inscription : champs de base uniquement. Impossible de se créer
      // admin, validé, ou avec un statut de modération.
      allow create: if connecte() && moi() == uid
        && request.resource.data.keys().hasOnly([
             'role', 'nom', 'email', 'telephone', 'statut', 'creeLe',
             'vehiculeId', 'plaqueImmatriculation', 'estValide'])
        && request.resource.data.role in ['client', 'conducteur']
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.get('estValide', false) == false;

      // Le propriétaire ne peut modifier que son nom, son téléphone et ses
      // pièces KYC ; envoyer une pièce remet le dossier "en_attente", sans
      // jamais pouvoir le passer à "valide". statutCompte, role et
      // estValide sont réservés à l'Admin.
      allow update: if estAdmin()
        || (connecte() && moi() == uid
            && champsModifies().hasOnly(['nom', 'telephone', 'documents', 'statutValidation'])
            && (!('statutValidation' in champsModifies())
                || request.resource.data.statutValidation == 'en_attente'));

      allow delete: if estAdmin();
    }

    // ---------------------------------------------------------------
    // Liaison chauffeur <-> client : preuve qu'un chauffeur a accepté une
    // course de ce client. Créée par le chauffeur dans la même écriture
    // que l'acceptation et vérifiée contre la course (voir /liaisons).
    // Elle seule ouvre l'accès au profil de l'autre et à la messagerie, et
    // seulement tant que la course est en cours : un client ne voit et ne
    // contacte que le chauffeur de sa course active, un chauffeur que le
    // client de la sienne.
    // Identifiant : "clientId_chauffeurId" (ou l'ordre inverse).
    // ---------------------------------------------------------------
    function courseEnCours(c) {
      return c.statut in ['acceptee', 'en_cours'];
    }

    // Terminée depuis moins d'un jour : le client peut encore lire le nom
    // de son chauffeur pour le noter.
    function courseRecemmentTerminee(c) {
      return c.statut == 'terminee'
        && c.get('termineeLe', null) != null
        && request.time < c.termineeLe + duration.value(1, 'd');
    }

    function aUneLiaison(a, b) {
      return exists(/databases/$(database)/documents/liaisons/$(a + '_' + b))
        || exists(/databases/$(database)/documents/liaisons/$(b + '_' + a));
    }

    function courseDeLiaison(a, b) {
      let liaison = exists(/databases/$(database)/documents/liaisons/$(a + '_' + b))
        ? get(/databases/$(database)/documents/liaisons/$(a + '_' + b)).data
        : get(/databases/$(database)/documents/liaisons/$(b + '_' + a)).data;
      return get(/databases/$(database)/documents/courses/$(liaison.courseId)).data;
    }

    // Contact en cours de course : messagerie.
    function contactEnCours(a, b) {
      return aUneLiaison(a, b) && courseEnCours(courseDeLiaison(a, b));
    }

    // Lecture du profil de l'autre : course en cours, ou tout juste terminée.
    function contactAutorise(a, b) {
      return aUneLiaison(a, b)
        && (courseEnCours(courseDeLiaison(a, b)) || courseRecemmentTerminee(courseDeLiaison(a, b)));
    }

    // La liaison ne peut être écrite que par le chauffeur assigné à une
    // course en cours de ce client (état APRÈS l'écriture : elle se fait
    // avec l'acceptation).
    function liaisonValide(liaison) {
      let course = getAfter(/databases/$(database)/documents/courses/$(liaison.courseId)).data;
      return liaison.chauffeurId == moi()
        && course.clientId == liaison.clientId
        && course.chauffeurId == moi()
        && courseEnCours(course);
    }

    match /liaisons/{liaisonId} {
      allow read: if estAdmin();

      allow create, update: if connecte()
        && request.resource.data.keys().hasOnly(['clientId', 'chauffeurId', 'courseId', 'creeLe'])
        && request.resource.data.clientId is string
        && request.resource.data.courseId is string
        && liaisonId in [
             request.resource.data.clientId + '_' + moi(),
             moi() + '_' + request.resource.data.clientId]
        && request.resource.data.creeLe == request.time
        && liaisonValide(request.resource.data);

      allow delete: if estAdmin();
    }

    // ---------------------------------------------------------------
    // Profil public : nom, téléphone, rôle, et pour un chauffeur son
    // véhicule et sa note. "disponible" (chauffeur validé et non
    // sanctionné) et le véhicule (modèle, plaque, vérifiés avec la carte
    // grise) ne sont écrits que par l'Admin.
    //
    // Lecture : son propre profil, l'Admin, ou l'autre partie d'une course
    // en cours (voir la liaison plus haut). JAMAIS de listage : aucun
    // utilisateur ne peut parcourir la liste des chauffeurs ni des clients.
    // ---------------------------------------------------------------
    match /profils_publics/{uid} {
      allow get: if connecte() && (moi() == uid || estAdmin() || contactAutorise(moi(), uid));
      allow list: if estAdmin();

      allow create: if estAdmin()
        || (connecte() && moi() == uid
            && request.resource.data.keys().hasOnly(['nom', 'telephone', 'role'])
            && request.resource.data.role == profil().role);

      allow update: if estAdmin()
        || (connecte() && moi() == uid
            && champsModifies().hasOnly(['nom', 'telephone']))
        // Note moyenne : un client ajoute SA note, dans la même écriture
        // que son évaluation (voir /evaluations).
        || (connecte() && evaluationAjoutee(uid));

      allow delete: if estAdmin();
    }

    // ---------------------------------------------------------------
    // Annuaire de connexion par téléphone : "{role}_{telephone}" -> email.
    // Lecture unitaire publique (nécessaire avant d'être connecté), jamais
    // de listage. Chacun ne peut publier que sa propre entrée, alignée sur
    // le rôle et le téléphone de son profil privé ; l'Admin peut tout
    // corriger (rattrapage des comptes existants).
    // ---------------------------------------------------------------
    match /annuaire_telephones/{cle} {
      allow get: if true;
      allow list: if false;

      allow write: if estAdmin();

      allow create: if connecte()
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == moi()
        && request.resource.data.email == request.auth.token.email
        && cle == profil().role + '_' + profil().telephone;

      allow update: if connecte()
        && resource.data.uid == moi()
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == moi()
        && request.resource.data.email == request.auth.token.email;

      allow delete: if connecte() && resource.data.uid == moi();
    }

    // ---------------------------------------------------------------
    // Commandes : demandes de paiement, écrites uniquement par le serveur
    // (Cloud Function "creerPaiement", webhook du fournisseur). Le client
    // suit la sienne pendant qu'il paie ; l'Admin les voit toutes.
    // La collection "config" (secrets du serveur) n'a aucune règle : elle
    // est fermée à l'app.
    // ---------------------------------------------------------------
    match /commandes/{commandeId} {
      allow read: if connecte() && (resource.data.clientId == moi() || estAdmin());
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Courses : créées par le serveur (Cloud Function), visibles des
    // chauffeurs actifs tant qu'elles sont en attente, acceptées par un
    // seul chauffeur actif. Le prix n'est jamais modifiable depuis l'app,
    // sauf par l'Admin.
    // ---------------------------------------------------------------
    match /courses/{courseId} {
      // Création réservée au serveur, une fois le paiement confirmé par le
      // fournisseur (webhook signé) : il calcule lui-même le prix à partir
      // des coordonnées. Aucun utilisateur, même Admin, ne crée une course
      // depuis l'app : personne ne choisit son prix ni ne voyage sans payer.
      allow create: if false;

      allow get: if connecte()
        && (resource.data.clientId == moi()
            || resource.data.chauffeurId == moi()
            || estAdmin()
            || (resource.data.statut == 'en_attente' && conducteurActif()));

      // Radar des chauffeurs : uniquement les courses en attente. Un
      // chauffeur retrouve aussi les courses qui lui sont attribuées, et
      // un client ses propres courses (ex. "Courses à noter").
      allow list: if estAdmin()
        || (resource.data.statut == 'en_attente' && conducteurActif())
        || (connecte() && resource.data.chauffeurId == moi())
        || (connecte() && resource.data.clientId == moi());

      allow update: if estAdmin()
        // Un chauffeur actif prend une course encore libre, pour lui-même.
        || (conducteurActif()
            && resource.data.statut == 'en_attente'
            && request.resource.data.statut == 'acceptee'
            && request.resource.data.chauffeurId == moi()
            && champsModifies().hasOnly(['statut', 'chauffeurId']))
        // Le chauffeur attribué fait avancer sa course : client à bord
        // (acceptee -> en_cours), puis arrivée (en_cours -> terminee).
        || (connecte()
            && resource.data.chauffeurId == moi()
            && resource.data.statut == 'acceptee'
            && request.resource.data.statut == 'en_cours'
            && champsModifies().hasOnly(['statut']))
        // À l'arrivée, la commission de la plateforme (15 % du prix,
        // arrondi à l'inférieur) est figée sur la course, avec l'heure de
        // fin : le chauffeur ne peut pas la choisir.
        || (connecte()
            && resource.data.chauffeurId == moi()
            && resource.data.statut == 'en_cours'
            && request.resource.data.statut == 'terminee'
            && request.resource.data.termineeLe == request.time
            && request.resource.data.commissionFcfa == math.floor(resource.data.prixFcfa * 15 / 100)
            && champsModifies().hasOnly(['statut', 'termineeLe', 'commissionFcfa']));
      // Annulations (client en attente, chauffeur avec un motif) :
      // uniquement par la Cloud Function "annulerCourse", qui rembourse le
      // client dans la foulée.

      allow delete: if estAdmin();
    }

    // ---------------------------------------------------------------
    // Position GPS des chauffeurs en ligne. Seul un chauffeur actif
    // publie sa propre position. L'Admin la lit (carte "Courses en
    // direct") ; le client la lit uniquement pendant SA course avec ce
    // chauffeur (suivi d'approche), via le champ courseId. Le document est
    // supprimé quand le chauffeur passe hors ligne : aucun historique de
    // trajets n'est conservé.
    // ---------------------------------------------------------------
    function clientSuitChauffeur(chauffeurUid) {
      let courseId = resource.data.get('courseId', null);
      return (courseId is string && coursePermetSuivi(courseId, chauffeurUid))
        || suitParLiaison(chauffeurUid);
    }

    // La liaison est écrite dans la transaction d'acceptation : le client
    // suit son chauffeur dès la seconde où la course est acceptée, sans
    // attendre que le téléphone du chauffeur ait republié sa position avec
    // le courseId (sinon la première lecture du client serait refusée et
    // son écoute Firestore s'arrêterait).
    function suitParLiaison(chauffeurUid) {
      let id = moi() + '_' + chauffeurUid;
      return exists(/databases/$(database)/documents/liaisons/$(id))
        && coursePermetSuivi(get(/databases/$(database)/documents/liaisons/$(id)).data.courseId, chauffeurUid);
    }

    function coursePermetSuivi(courseId, chauffeurUid) {
      let course = get(/databases/$(database)/documents/courses/$(courseId)).data;
      return course.clientId == moi()
        && course.chauffeurId == chauffeurUid
        && course.statut in ['acceptee', 'en_cours'];
    }

    match /positions_chauffeurs/{uid} {
      allow list: if estAdmin();

      // resource == null : position pas encore publiée (le client peut
      // attendre qu'elle apparaisse, sans rien apprendre de plus).
      allow get: if estAdmin()
        || (connecte() && (resource == null || clientSuitChauffeur(uid)));

      allow create, update: if connecte() && moi() == uid && conducteurActif()
        && request.resource.data.keys().hasOnly([
             'latitude', 'longitude', 'precision', 'cap', 'vitesse', 'majLe', 'courseId'])
        && (!('courseId' in request.resource.data) || request.resource.data.courseId is string)
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
        && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
        && request.resource.data.majLe == request.time;

      allow delete: if estAdmin() || (connecte() && moi() == uid);
    }

    // ---------------------------------------------------------------
    // Évaluations : une par course (identifiant = courseId), laissée par
    // le client de la course une fois terminée, jamais modifiable. La note
    // moyenne du chauffeur (noteSomme / noteNombre dans son profil public)
    // est mise à jour dans la même écriture : l'une ne va pas sans l'autre.
    // ---------------------------------------------------------------
    function evaluationAjoutee(chauffeurUid) {
      let courseId = request.resource.data.get('derniereEvaluation', null);
      return courseId is string
        && champsModifies().hasOnly(['noteSomme', 'noteNombre', 'derniereEvaluation'])
        && !exists(/databases/$(database)/documents/evaluations/$(courseId))
        && notesAjoutees(getAfter(/databases/$(database)/documents/evaluations/$(courseId)).data, chauffeurUid);
    }

    function notesAjoutees(evaluation, chauffeurUid) {
      return evaluation.chauffeurId == chauffeurUid
        && evaluation.clientId == moi()
        && request.resource.data.noteNombre == resource.data.get('noteNombre', 0) + 1
        && request.resource.data.noteSomme == resource.data.get('noteSomme', 0) + evaluation.note;
    }

    function courseTermineeDuClient(courseId, chauffeurUid) {
      let course = get(/databases/$(database)/documents/courses/$(courseId)).data;
      return course.clientId == moi()
        && course.chauffeurId == chauffeurUid
        && course.statut == 'terminee';
    }

    match /evaluations/{courseId} {
      allow get: if connecte()
        && (resource == null
            || resource.data.clientId == moi()
            || resource.data.chauffeurId == moi()
            || estAdmin());
      allow list: if connecte()
        && (resource.data.clientId == moi() || resource.data.chauffeurId == moi() || estAdmin());

      allow create: if connecte()
        && request.resource.data.keys().hasOnly([
             'courseId', 'chauffeurId', 'clientId', 'note', 'commentaire', 'creeLe'])
        && request.resource.data.courseId == courseId
        && request.resource.data.clientId == moi()
        && request.resource.data.note is int
        && request.resource.data.note >= 1 && request.resource.data.note <= 5
        && (!('commentaire' in request.resource.data)
            || (request.resource.data.commentaire is string
                && request.resource.data.commentaire.size() <= 500))
        && request.resource.data.creeLe == request.time
        && courseTermineeDuClient(courseId, request.resource.data.chauffeurId)
        && getAfter(/databases/$(database)/documents/profils_publics/$(request.resource.data.chauffeurId))
             .data.get('derniereEvaluation', null) == courseId;

      allow update: if false;
      allow delete: if estAdmin();
    }

    // ---------------------------------------------------------------
    // Finances. La plateforme encaisse toutes les courses (Wave / Orange
    // Money) et reverse au chauffeur sa part (85 %). Les versements sont
    // saisis par l'Admin seul, visibles du chauffeur concerné ; un
    // chauffeur ne doit jamais rien à la plateforme.
    // ---------------------------------------------------------------
    match /reglements/{reglementId} {
      allow read: if connecte() && (resource.data.chauffeurId == moi() || estAdmin());

      allow create: if estAdmin()
        && request.resource.data.keys().hasOnly(['chauffeurId', 'montantFcfa', 'sens', 'note', 'creeLe'])
        && request.resource.data.chauffeurId is string
        && request.resource.data.montantFcfa is int
        && request.resource.data.montantFcfa > 0
        && request.resource.data.sens == 'plateforme_vers_chauffeur'
        && request.resource.data.creeLe == request.time;

      allow update: if false;
      allow delete: if estAdmin();
    }

    // Temps en ligne du chauffeur, par jour ("{uid}_{AAAA-MM-JJ}") : +60 s
    // par minute passée en ligne, au plus une fois toutes les 50 s.
    match /temps_en_ligne/{jourId} {
      allow read: if connecte() && (resource.data.chauffeurId == moi() || estAdmin());

      allow create: if connecte()
        && jourId == moi() + '_' + request.resource.data.date
        && request.resource.data.keys().hasOnly(['chauffeurId', 'date', 'secondes', 'majLe'])
        && request.resource.data.chauffeurId == moi()
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.secondes == 60
        && request.resource.data.majLe == request.time;

      allow update: if connecte()
        && resource.data.chauffeurId == moi()
        && champsModifies().hasOnly(['secondes', 'majLe'])
        && request.resource.data.secondes == resource.data.secondes + 60
        && request.resource.data.majLe == request.time
        && request.time > resource.data.majLe + duration.value(50, 's');

      allow delete: if estAdmin();
    }

    // ---------------------------------------------------------------
    // Support : un ticket par course (identifiant = courseId), ouvert par
    // le client de cette course depuis son historique. Conversation en
    // sous-collection "messages" entre le client et l'Admin (et les
    // messages automatiques du serveur). L'Admin traite : réponses,
    // statut, lecture. Remboursements et sanctions passent par le
    // serveur (Cloud Functions), tracés dans "journal_admin".
    // ---------------------------------------------------------------
    function ticketDuClient(courseId) {
      let ticket = getAfter(/databases/$(database)/documents/tickets/$(courseId));
      return ticket != null && ticket.data.clientId == moi();
    }

    match /tickets/{courseId} {
      // resource == null : savoir si un ticket existe déjà pour la course.
      allow get: if connecte()
        && (resource == null || resource.data.clientId == moi() || estAdmin());
      allow list: if estAdmin() || (connecte() && resource.data.clientId == moi());

      allow create: if connecte()
        && request.resource.data.keys().hasOnly([
             'courseId', 'clientId', 'chauffeurId', 'categorie', 'statut',
             'creeLe', 'majLe', 'dernierMessage', 'nonLuAdmin', 'nonLuClient'])
        && request.resource.data.courseId == courseId
        && request.resource.data.clientId == moi()
        && get(/databases/$(database)/documents/courses/$(courseId)).data.clientId == moi()
        && request.resource.data.chauffeurId
             == get(/databases/$(database)/documents/courses/$(courseId)).data.get('chauffeurId', null)
        && request.resource.data.categorie in ['chauffeur', 'prix', 'objet_perdu', 'securite', 'autre']
        && request.resource.data.statut == 'ouvert'
        && request.resource.data.creeLe == request.time
        && request.resource.data.majLe == request.time
        && request.resource.data.dernierMessage is string
        && request.resource.data.dernierMessage.size() <= 200
        && request.resource.data.nonLuAdmin == true
        && request.resource.data.nonLuClient == false;

      // Le client lit les réponses (nonLuClient -> false) ou écrit un
      // nouveau message, ce qui rouvre le ticket s'il était résolu.
      allow update: if estAdmin()
        || (connecte() && resource.data.clientId == moi()
            && champsModifies().hasOnly(['nonLuClient'])
            && request.resource.data.nonLuClient == false)
        || (connecte() && resource.data.clientId == moi()
            && champsModifies().hasOnly(['majLe', 'dernierMessage', 'nonLuAdmin', 'statut', 'nonLuClient'])
            && request.resource.data.majLe == request.time
            && request.resource.data.dernierMessage is string
            && request.resource.data.dernierMessage.size() <= 200
            && request.resource.data.nonLuAdmin == true
            && request.resource.data.nonLuClient == false
            && request.resource.data.statut == 'ouvert');

      allow delete: if estAdmin();

      match /messages/{messageId} {
        allow read: if connecte() && (estAdmin()
          || get(/databases/$(database)/documents/tickets/$(courseId)).data.clientId == moi());

        allow create: if connecte()
          && request.resource.data.keys().hasOnly(['auteurId', 'auteurRole', 'texte', 'creeLe'])
          && request.resource.data.auteurId == moi()
          && request.resource.data.texte is string
          && request.resource.data.texte.size() > 0
          && request.resource.data.texte.size() <= 1000
          && request.resource.data.creeLe == request.time
          && ((request.resource.data.auteurRole == 'client' && ticketDuClient(courseId))
              || (request.resource.data.auteurRole == 'admin' && estAdmin()));

        allow update, delete: if false;
      }
    }

    // Journal des actions de l'Admin (remboursements, sanctions) : écrit
    // par le serveur seul, lisible par l'Admin.
    match /journal_admin/{entreeId} {
      allow read: if estAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Messagerie : l'identifiant d'un chat est "uidA_uidB" (UID triés),
    // l'appartenance se lit donc dans l'identifiant lui-même.
    // ---------------------------------------------------------------
    function membreDuChat(chatId) {
      return connecte() && moi() in chatId.split('_');
    }

    // On n'écrit qu'à l'autre partie d'une course en cours ; l'historique
    // reste lisible par ses deux participants.
    function contactEnCoursDuChat(chatId) {
      let ids = chatId.split('_');
      return ids.size() == 2 && contactEnCours(ids[0], ids[1]);
    }

    match /chats/{chatId} {
      allow get: if membreDuChat(chatId);
      allow list: if connecte() && moi() in resource.data.participants;

      allow create, update: if membreDuChat(chatId)
        && contactEnCoursDuChat(chatId)
        && chatId.split('_').size() == 2
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.toSet() == chatId.split('_').toSet();

      match /messages/{messageId} {
        allow read: if membreDuChat(chatId);
        allow create: if membreDuChat(chatId)
          && contactEnCoursDuChat(chatId)
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'timestamp'])
          && request.resource.data.senderId == moi();
      }
    }
  }
}
