rules_version = '2';

// Règles Firebase Storage du projet Sprint VTC (publiées par la CI dès que
// Storage est activé, voir FIREBASE_SETUP.md, étape 5).
//
// Seules les 4 pièces d'un chauffeur existent, à un emplacement fixe :
//   kyc_documents/{uid}/permis.jpg | carteGrise.jpg | attestationVtc.jpg
//   | photoProfil.jpg
// Le chauffeur est le seul à pouvoir les écrire, remplacer, relire ou
// supprimer. L'Admin les affiche via l'URL de téléchargement (jeton
// secret) enregistrée dans Firestore (`users/{uid}.documents`), lisible par
// le seul propriétaire et l'Admin : aucune règle croisée Firestore ↔ Storage,
// qui exigerait un droit supplémentaire non automatisable dans la CI.
service firebase.storage {
  match /b/{bucket}/o {
    match /kyc_documents/{uid}/{fichier} {
      function proprietaire() {
        return request.auth != null && request.auth.uid == uid;
      }

      function pieceConnue() {
        return fichier in ['permis.jpg', 'carteGrise.jpg', 'attestationVtc.jpg', 'photoProfil.jpg'];
      }

      // Pas de liste des fichiers : on lit une pièce précise ou rien.
      allow get: if proprietaire() && pieceConnue();
      allow list: if false;

      // Même plafond que l'app (5 Mo), images uniquement.
      allow create, update: if proprietaire() && pieceConnue()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if proprietaire() && pieceConnue();
    }

    // Tout le reste est fermé.
    match /{autre=**} {
      allow read, write: if false;
    }
  }
}
