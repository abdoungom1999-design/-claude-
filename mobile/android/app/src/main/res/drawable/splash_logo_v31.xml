<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : le système dessine l'icône dans un cercle de 288 dp dont
     seuls les deux tiers centraux (192 dp) sont visibles : la tuile (128 dp,
     coins compris) y tient entière. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item
        android:width="128dp"
        android:height="128dp"
        android:gravity="center"
        android:drawable="@drawable/splash_logo" />
</layer-list>
